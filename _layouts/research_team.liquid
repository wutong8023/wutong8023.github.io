---
layout: default
---

<!-- The Main Content -->
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    {% if site.data.research_team.phd_students %}
      {% include research_team/research_team_table.liquid research_team=site.data.research_team.phd_students %}
    {% endif %}

    {% if site.data.research_team.postgraduate_students %}
      {% include research_team/research_team_table.liquid research_team=site.data.research_team.postgraduate_students %}
    {% endif %}

    {% if site.data.research_team.alumni %}
      {% include research_team/research_team_table.liquid research_team=site.data.research_team.alumni %}
    {% endif %}
  </article>
</div>

