<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in entry.contents %}
    <li class="list-group-item">
      <div class="row">
        {% if content.period %}
          <div class="col-xs-2 cl-sm-2 col-md-2 text-center" style="width: 75px">
            <table class="table-cv">
              <tbody>
                <tr>
                  <td>
                    <span class="badge font-weight-bold primary-color-dark text-uppercase align-middle" style="min-width: 75px">
                      {{- content.period -}}
                    </span>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        {% endif %}
        <div class="col-xs-10 cl-sm-10 col-md-10 mt-2 mt-md-0">
          {% if content.name %}
            <h6 class="title font-weight-bold ml-1 ml-md-4">{{ content.name }}</h6>
          {% endif %}
          {% if content.degree %}
            <div class="ml-1 ml-md-4">
              <div class="d-flex align-items-baseline flex-wrap">
                <div style="width: 20px; margin-right: 8px;" class="mb-1">
                  <i class="fa-solid fa-graduation-cap icondegree" style="color: var(--global-theme-color)"></i>
                </div>
                <div class="flex-grow-1">
                  <span class="degree">{{ content.degree }}{% if content.research %} - {{ content.research }}{% endif %}</span>
                </div>
              </div>
            </div>
          {% elsif content.research %}
            <div class="ml-1 ml-md-4">
              <div class="d-flex align-items-baseline flex-wrap">
                <div style="width: 20px; margin-right: 8px;" class="mb-1">
                  <i class="fa-solid fa-flask iconresearch" style="color: var(--global-theme-color)"></i>
                </div>
                <div class="flex-grow-1">
                  <span class="research">{{ content.research }}</span>
                </div>
              </div>
            </div>
          {% endif %}
          {% if content.affiliation %}
            <div class="ml-1 ml-md-4">
              <div class="d-flex align-items-baseline flex-wrap">
                <div style="width: 20px; margin-right: 8px;" class="mb-1">
                  <i class="fa-solid fa-building-columns iconinstitution" style="color: var(--global-theme-color)"></i>
                </div>
                <div class="flex-grow-1">
                  {% if content.affiliation.first %}
                    {% for affil in content.affiliation %}
                      <span class="institution">{{ affil }}{% unless forloop.last %}, {% endunless %}</span>
                    {% endfor %}
                  {% else %}
                    <span class="institution">{{ content.affiliation }}</span>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endif %}
          {% if content.current_position %}
            <div class="ml-1 ml-md-4">
              <div class="d-flex align-items-baseline flex-wrap">
                <div style="width: 20px; margin-right: 8px;" class="mb-1">
                  <i class="fa-solid fa-briefcase iconposition" style="color: var(--global-theme-color)"></i>
                </div>
                <div style="width: 120px;" class="mb-1">
                  <span class="position-label">Current Position:</span>
                </div>
                <div class="flex-grow-1">
                  <span class="position-content">{{ content.current_position }}</span>
                </div>
              </div>
            </div>
          {% endif %}
          {% if content.co-supervisor %}
            <div class="ml-1 ml-md-4">
              <div class="d-flex align-items-baseline flex-wrap">
                <div style="width: 20px; margin-right: 8px;" class="mb-1">
                  <i class="fa-solid fa-user-graduate iconco-supervisor" style="color: var(--global-theme-color)"></i>
                </div>
                <div style="width: 120px;" class="mb-1">
                  <span class="co-supervisor-label">Co-supervisors:</span>
                </div>
                <div class="flex-grow-1">
                  <span class="co-supervisor-content">
                    {% for supervisor in content.co-supervisor %}
                      {% if supervisor.url %}
                        <a href="{{ supervisor.url }}" target="_blank" class="themed">{{ supervisor.name }}</a>{% unless forloop.last %}, {% endunless %}
                      {% else %}
                        {{ supervisor.name }}{% unless forloop.last %}, {% endunless %}
                      {% endif %}
                    {% endfor %}
                  </span>
                </div>
              </div>
            </div>
          {% endif %}
          {% if content.homepage %}
            <div class="container-links ml-1 ml-md-4">
              <div class="container-link-button">
                <a href="{{ content.homepage }}" target="_blank" class="btncv z-depth-0">Homepage</a>
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
