<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in entry.contents %}
    <li class="list-group-item p-0">
      <h5 class="title-header badge font-weight-bold text-uppercase">{{ content.title }}</h5>
      {% if content.items %}
        <ul class="subitems">
          {% for subitem in content.items %}
            <li class="{% if content.title contains 'conference' %}conference-item{% elsif content.title contains 'journal' %}journal-item{% elsif content.title contains 'research interest' %}research-item{% else %}arrow-item{% endif %}">
              <span class="subitem">
                {% if content.title contains 'conference' %}
                  {% assign parts = subitem | split: "(" %}
                  <strong>{{ parts.first | strip }}</strong>{% if parts.size > 1 %} ({{ parts.last }}{% endif %}
                {% else %}
                  {{ subitem }}
                {% endif %}
              </span>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </li>
  {% endfor %}
</ul>

<style>
.subitems {
  list-style: none;
  padding-left: 1.2em;
}

.arrow-item, .conference-item, .journal-item, .research-item {
  position: relative;
  margin-bottom: 0.3em;
}

.arrow-item::before {
  content: "→";
  position: absolute;
  left: -1.2em;
  color: var(--global-theme-color);
}

.conference-item::before {
  font-family: "Font Awesome 6 Free";
  content: "\f3c5";  /* fa-map-marker-alt */
  font-weight: 900;
  position: absolute;
  left: -1.2em;
  color: var(--global-theme-color);
}

.journal-item::before {
  font-family: "Font Awesome 6 Free";
  content: "\f02d";  /* fa-book */
  font-weight: 900;
  position: absolute;
  left: -1.2em;
  color: var(--global-theme-color);
}

.research-item::before {
  font-family: "Font Awesome 6 Free";
  content: "\f002";  /* fa-magnifying-glass */
  font-weight: 900;
  position: absolute;
  left: -1.2em;
  color: var(--global-theme-color);
}

.title-header {
  background-color: var(--global-theme-color) !important;
  color: var(--global-bg-color) !important;
  margin: 0;
  padding: 0.5rem 1rem;
  text-align: left;
  width: 100%;
  border-radius: 0;
  font-size: 1rem;
}

[data-theme='dark'] .title-header {
  background-color: var(--global-theme-color) !important;
  color: var(--global-bg-color) !important;
}

.list-group-item {
  border: 1px solid rgba(0,0,0,.125);
}

.list-group-item .subitems {
  padding: 1rem;
}
</style>
