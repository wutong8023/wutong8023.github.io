<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in entry.contents %}
    <li class="list-group-item p-0">
      <h5 class="title-header badge font-weight-bold text-uppercase">{{ content.title }}</h5>
      {% if content.items %}
        <ul class="subitems">
          {% for subitem in content.items %}
            <li class="{% if content.title contains 'Conferences' %}conference-item{% elsif content.title contains 'Journals' %}journal-item{% elsif content.title contains 'Knowledge Evolution' %}research-item{% else %}arrow-item{% endif %}">
              {% if content.title contains 'Conferences' %}
                {% assign parts = subitem | split: "(" %}
                {% assign conf_name = parts.first | strip %}
                {% assign dates = parts.last | remove: ")" | strip %}
                <div class="conference-grid">
                  <strong class="conf-name">{{ conf_name }}</strong>
                  <span class="conf-date">{{ dates }}</span>
                </div>
              {% else %}
                <span class="subitem">{{ subitem }}</span>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </li>
  {% endfor %}
</ul>
