<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in entry.contents %}
    <li class="list-group-item p-0">
      <h5 class="title-header badge font-weight-bold text-uppercase">{{ content.title }}</h5>
      {% if content.items %}
        <ul class="subitems">
          {% for subitem in content.items %}
            <li class="{% if content.title contains 'Conferences' %}conference-item{% elsif content.title contains 'Journals' %}journal-item{% elsif content.title contains 'Knowledge Evolution' %}research-item{% else %}arrow-item{% endif %}">
              {% if content.title contains 'Conferences' %}
                {% assign parts = subitem | split: "(" %}
                {% assign conf_name = parts.first | strip %}
                {% assign dates = parts.last | remove: ")" | strip %}
                <div class="conference-grid">
                  <strong class="conf-name">{{ conf_name }}</strong>
                  <span class="conf-date">{{ dates }}</span>
                </div>
              {% else %}
                <span class="subitem">{{ subitem }}</span>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </li>
  {% endfor %}
</ul>

<style>
.subitems {
  list-style: none;
  padding-left: 2.5em;
  margin-left: 1rem;
}

.arrow-item, .conference-item, .journal-item, .research-item {
  position: relative;
  margin-bottom: 0.3em;
}

.arrow-item::before {
  font-family: "Font Awesome 6 Free";
  content: "\f152";  /* fa-square-caret-right */
  font-weight: 400;  /* regular style for half-filled effect */
  position: absolute;
  left: -1.8em;
  color: var(--global-theme-color);
}

.conference-item::before {
  font-family: "Font Awesome 6 Free";
  content: "\f3c5";  /* fa-map-marker-alt */
  font-weight: 900;
  position: absolute;
  left: -1.8em;
  color: var(--global-theme-color);
}

.journal-item::before {
  font-family: "Font Awesome 6 Free";
  content: "\f02d";  /* fa-book */
  font-weight: 900;
  position: absolute;
  left: -1.8em;
  color: var(--global-theme-color);
}

.research-item::before {
  font-family: "Font Awesome 6 Free";
  content: "\f002";  /* fa-magnifying-glass */
  font-weight: 900;
  position: absolute;
  left: -1.8em;
  color: var(--global-theme-color);
}

.title-header {
  background-color: var(--global-theme-color) !important;
  color: var(--global-bg-color) !important;
  margin: 0;
  padding: 0.5rem 1rem;
  text-align: left;
  width: 100%;
  border-radius: 0;
  font-size: 1rem;
}

[data-theme='dark'] .title-header {
  background-color: var(--global-theme-color) !important;
  color: var(--global-bg-color) !important;
}

.list-group-item {
  border: 1px solid rgba(0,0,0,.125);
}

.list-group-item .subitems {
  padding: 1rem;
}

.conference-grid {
  display: grid;
  grid-template-columns: minmax(100px, 200px) auto;
  gap: 1rem;
  align-items: center;
}

.conf-name {
  min-width: 100px;
}

.conf-date {
  color: var(--global-text-color);
}
</style>
